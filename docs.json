{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "LayerAI",
  "favicon": "/assets/favicon.ico",
  "logo": {
    "light": "/assets/logo/logo.png",
    "dark": "/assets/logo/logo.png",
    "href": "/"
  },
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#22D3EE",
    "light": "#67E8F9",
    "dark": "#6366F1"
  },
  "background": {
    "color": {
      "light": "#F8FAFC",
      "dark": "#050816"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "redirects": [
    {
      "source": "/quickstart/install",
      "destination": "/journey/install"
    },
    {
      "source": "/quickstart/basic-settings",
      "destination": "/journey/basic-settings"
    },
    {
      "source": "/quickstart/login",
      "destination": "/journey/login"
    },
    {
      "source": "/quickstart/first-translation",
      "destination": "/journey/first-translation"
    },
    {
      "source": "/collection/overview",
      "destination": "/modules/collection"
    },
    {
      "source": "/glossary/overview",
      "destination": "/modules/glossary"
    },
    {
      "source": "/models/overview",
      "destination": "/modules/models"
    },
    {
      "source": "/shared/overview",
      "destination": "/modules/shared"
    },
    {
      "source": "/queue/overview",
      "destination": "/modules/queue"
    },
    {
      "source": "/images/:path*",
      "destination": "/assets/images/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "/assets/videos/:path*"
    },
    {
      "source": "/logo/:path*",
      "destination": "/assets/logo/:path*"
    },
    {
      "source": "/snippets/:path*",
      "destination": "/assets/snippets/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.ico"
    }
  ],
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "mcp"]
  },
  "navigation": {
    "description": "Official LayerAI browser extension docs: page collection, AI translation, glossary governance, data sync, and shared collaboration.",
    "seo": {
      "metatags": {
        "og:site_name": "LayerAI Docs",
        "og:url": "https://docs.layerai.yun"
      }
    },
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "introduction",
              "introduction/concepts",
              "journey/install",
              "journey/basic-settings",
              "journey/login",
              "journey/first-translation",
              "introduction/ui-tour",
              "journey/product-map"
            ]
          },
          {
            "group": "Features",
            "icon": "layout-grid",
            "pages": [
              {
                "group": "Collection",
                "icon": "mouse-pointer",
                "pages": [
                  "modules/collection",
                  "collection/manual",
                  "collection/current-page",
                  "collection/current-site",
                  "collection/rules"
                ]
              },
              {
                "group": "Translation",
                "icon": "globe",
                "pages": [
                  "modules/translation",
                  "translation/site-list",
                  "translation/edit-entries",
                  "translation/manual-translation",
                  "translation/ai-batch",
                  "modules/queue",
                  "queue/task-management",
                  "translation/submit-shared"
                ]
              },
              {
                "group": "Replace",
                "icon": "repeat",
                "pages": [
                  "modules/replace",
                  "replace/auto-replace",
                  "replace/modes",
                  "replace/page-modal"
                ]
              },
              {
                "group": "Models",
                "icon": "cpu",
                "pages": [
                  "modules/models",
                  "models/platform-models",
                  "models/custom-models",
                  "models/prompts",
                  "models/runtime-config"
                ]
              },
              {
                "group": "Glossary",
                "icon": "book-a",
                "pages": [
                  "modules/glossary",
                  "glossary/local-glossary",
                  "glossary/platform-glossary",
                  "glossary/sync"
                ]
              },
              {
                "group": "Sync & sharing",
                "icon": "cloud",
                "pages": [
                  "modules/sync",
                  "sync/local-import-export",
                  "sync/layer-cloud",
                  "sync/google-drive",
                  "modules/shared",
                  "shared/browse-download",
                  "shared/submit",
                  "shared/discover-modes"
                ]
              },
              {
                "group": "Account & settings",
                "icon": "credit-card",
                "pages": [
                  "modules/account-settings",
                  "account/login",
                  "account/plans",
                  "account/quotas",
                  "settings/basic",
                  "settings/shared-settings",
                  "advanced/developer",
                  "advanced/protected-tags",
                  "advanced/sensitive-mask"
                ]
              }
            ]
          },
          {
            "group": "Help",
            "icon": "circle-help",
            "pages": [
              "troubleshooting/index",
              "troubleshooting/ai-errors",
              "troubleshooting/sync-errors",
              "appendix/glossary",
              "appendix/data-format"
            ]
          }
        ]
      },
      {
        "tab": "Website",
        "icon": "globe",
        "href": "https://layerai.yun"
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
