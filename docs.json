{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "LayerAI",
  "favicon": "/assets/favicon.ico",
  "logo": {
    "light": "/assets/logo/logo.png",
    "dark": "/assets/logo/logo.png",
    "href": "/"
  },
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#22D3EE",
    "light": "#67E8F9",
    "dark": "#6366F1"
  },
  "background": {
    "color": {
      "light": "#F8FAFC",
      "dark": "#050816"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "redirects": [
    {
      "source": "/quickstart/install",
      "destination": "/journey/install"
    },
    {
      "source": "/quickstart/basic-settings",
      "destination": "/journey/basic-settings"
    },
    {
      "source": "/quickstart/login",
      "destination": "/journey/login"
    },
    {
      "source": "/quickstart/first-translation",
      "destination": "/journey/first-translation"
    },
    {
      "source": "/images/:path*",
      "destination": "/assets/images/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "/assets/videos/:path*"
    },
    {
      "source": "/logo/:path*",
      "destination": "/assets/logo/:path*"
    },
    {
      "source": "/snippets/:path*",
      "destination": "/assets/snippets/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.ico"
    }
  ],
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "mcp"]
  },
  "navigation": {
    "description": "LayerAI 浏览器扩展官方文档：网页采集、AI 翻译、词库治理、数据同步与共享协作。",
    "seo": {
      "metatags": {
        "og:site_name": "LayerAI 使用文档",
        "og:url": "https://layerai.yun"
      }
    },
    "tabs": [
      {
        "tab": "文档",
        "icon": "book-open",
        "groups": [
          {
            "group": "开始使用",
            "icon": "rocket",
            "pages": [
              "introduction",
              "introduction/concepts",
              "introduction/ui-tour",
              "journey/install",
              "journey/basic-settings",
              "journey/login",
              "journey/first-translation",
              "journey/product-map"
            ]
          },
          {
            "group": "功能模块",
            "icon": "layout-grid",
            "pages": [
              "modules/collection",
              "modules/translation",
              "modules/replace",
              "modules/glossary",
              "modules/models",
              "modules/sync",
              "modules/shared",
              "modules/account-settings"
            ]
          },
          {
            "group": "网页采集",
            "icon": "mouse-pointer",
            "pages": [
              "collection/overview",
              "collection/manual",
              "collection/current-page",
              "collection/current-site",
              "collection/rules"
            ]
          },
          {
            "group": "翻译管理",
            "icon": "globe",
            "pages": [
              "translation/site-list",
              "translation/edit-entries",
              "translation/manual-translation",
              "translation/ai-batch",
              "queue/overview",
              "queue/task-management",
              "translation/submit-shared"
            ]
          },
          {
            "group": "页面替换",
            "icon": "repeat",
            "pages": [
              "replace/auto-replace",
              "replace/modes",
              "replace/page-modal"
            ]
          },
          {
            "group": "模型配置",
            "icon": "cpu",
            "pages": [
              "models/overview",
              "models/platform-models",
              "models/custom-models",
              "models/prompts",
              "models/runtime-config"
            ]
          },
          {
            "group": "词库",
            "icon": "book-a",
            "pages": [
              "glossary/overview",
              "glossary/local-glossary",
              "glossary/platform-glossary",
              "glossary/sync"
            ]
          },
          {
            "group": "数据同步",
            "icon": "cloud",
            "pages": [
              "sync/local-import-export",
              "sync/layer-cloud",
              "sync/google-drive"
            ]
          },
          {
            "group": "共享翻译",
            "icon": "share-2",
            "pages": [
              "shared/overview",
              "shared/browse-download",
              "shared/submit",
              "shared/discover-modes"
            ]
          },
          {
            "group": "账号与设置",
            "icon": "credit-card",
            "pages": [
              "account/login",
              "account/plans",
              "account/quotas",
              "settings/basic",
              "settings/shared-settings"
            ]
          },
          {
            "group": "故障排查",
            "icon": "file-question-mark",
            "pages": [
              "troubleshooting/index",
              "troubleshooting/ai-errors",
              "troubleshooting/sync-errors"
            ]
          },
          {
            "group": "附录",
            "icon": "file-text",
            "pages": [
              "appendix/glossary",
              "appendix/data-format"
            ]
          }
        ]
      },
      {
        "tab": "安装",
        "icon": "download",
        "pages": [
          "journey/install"
        ]
      },
      {
        "tab": "官网",
        "icon": "globe",
        "href": "https://layerai.yun"
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
